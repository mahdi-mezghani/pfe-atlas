# Supabase client settings (public anon/publishable key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase server settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Chat and metadata provider
AI_PROVIDER=gemini
AI_GEMINI_API_KEY=your-gemini-api-key

# Optional local embeddings via Ollama, independent from AI_PROVIDER
# AI_EMBEDDING_PROVIDER=ollama
# AI_OLLAMA_BASE_URL=http://localhost:11434
# AI_OLLAMA_EMBEDDING_MODEL=qwen3-embedding:latest
# AI_OLLAMA_KEEP_ALIVE=60s
# AI_OLLAMA_NUM_THREADS=4
